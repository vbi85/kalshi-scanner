# ===== Copy to .env and fill in. Never commit .env to GitHub. =====

# --- Mode: paper (simulate) or live (real orders, only for assets that pass ALL gates) ---
TRADING_MODE=paper
KALSHI_DEMO=false            # true = send live orders to Kalshi's demo exchange (fake money) for a dry run

# --- Kalshi API key (only needed for live/demo trading; scanning needs no key) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/opt/kalshi-scanner/kalshi_key.pem

# --- Markets ---
SERIES=KXBTC15M,KXWTI15M
AUTO_DISCOVER=true           # also finds gold, silver, oil, natural gas series automatically
MAX_MINUTES_TO_CLOSE=60
MIN_MINUTES_TO_CLOSE=1.5
POLL_SECONDS=20

# --- Signal rules ---
MIN_EDGE=0.06                # minimum expected profit per $1 contract after fees + slippage
MIN_ASK_SIZE=5
MIN_PRICE=0.05
MAX_PRICE=0.90
VOL_MULT=1.25

# --- Approval gates (per asset, measured on paper results) ---
GATE_MIN_TRADES=150
GATE_MIN_DAYS=7
GATE_MIN_PROFIT_FACTOR=1.25
GATE_MIN_CALIBRATION_PTS=3
GATE_MAX_DRAWDOWN=15
GATE_RECENT_N=50

# --- Live risk caps ---
MAX_CONTRACTS_PER_TRADE=5
MAX_DOLLARS_PER_TRADE=10
MAX_DAILY_LOSS=25
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=20
LIVE_LOSS_STREAK_KILL=6

# --- Text alerts: console, email_sms, twilio (comma-separate for several) ---
ALERT_METHOD=console,email_sms
SMTP_USER=you@gmail.com
SMTP_PASSWORD=               # Gmail App Password (Google Account > Security > App passwords)
SMS_GATEWAY_TO=              # Verizon: 4145551234@vtext.com   T-Mobile: 4145551234@tmomail.net
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
MAX_ALERTS_PER_HOUR=12

# --- Dashboard ---
DASH_USER=admin
DASH_PASSWORD=change-me-now
DASH_PORT=8080
TZ_NAME=America/Chicago
DB_PATH=data/trades.db
