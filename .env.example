# ===== Copy to .env and fill in. Never commit .env to GitHub. =====

# --- Mode: paper (simulate) or live (real orders, only for assets that pass ALL gates) ---
TRADING_MODE=paper           # starting mode only — use the PAPER/LIVE switch on the dashboard
KALSHI_DEMO=false            # true = send live orders to Kalshi's demo exchange (fake money) for a dry run

# --- Kalshi API key: easiest is the "Connect" button on the dashboard (leave these blank) ---
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# --- Markets (15-minute UP/DOWN) ---
SERIES=KXBTC15M,KXGOLD15M,KXWTI15M,KXNATGAS15M
AUTO_DISCOVER=false
MAX_MINUTES_TO_CLOSE=16
POLL_SECONDS=10

# --- Trade window ---
ENTRY_START_MIN=7.5          # no trades until 7:30 or less remains
ENTRY_END_MIN=2.0            # no new trades under 2:00

# --- Momentum (decides UP or DOWN) ---
MOM_LOOKBACK_MIN=5           # measured over the last 5 minutes
MOM_MIN_Z=0.5                # minimum strength in standard deviations
MOM_WEIGHT=0.25              # how much of the recent trend is assumed to continue

# --- Signal rules ---
MIN_EDGE=0.05                # minimum expected profit per $1 contract after fees + slippage
MAX_PRICE_AGE_SEC=60         # refuse to trade on prices older than this
MIN_ASK_SIZE=5
MIN_PRICE=0.05
MAX_PRICE=0.90
VOL_MULT=1.25

# --- Approval gates (per asset, measured on paper results) ---
GATE_MIN_TRADES=150
GATE_MIN_DAYS=7
GATE_MIN_PROFIT_FACTOR=1.25
GATE_MIN_CALIBRATION_PTS=3
GATE_MAX_DRAWDOWN=15
GATE_RECENT_N=50

# --- Live risk caps ---
MAX_CONTRACTS_PER_TRADE=5
MAX_DOLLARS_PER_TRADE=10
MAX_DAILY_LOSS=25
MAX_OPEN_POSITIONS=3
MAX_TRADES_PER_DAY=20
LIVE_LOSS_STREAK_KILL=6

# --- Text alerts: console, email_sms, twilio (comma-separate for several) ---
ALERT_METHOD=console,email_sms
SMTP_USER=you@gmail.com
SMTP_PASSWORD=               # Gmail App Password (Google Account > Security > App passwords)
SMS_GATEWAY_TO=              # T-Mobile: 4145551234@tmomail.net   Verizon: 4145551234@vtext.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_TO=
MAX_ALERTS_PER_HOUR=12

# --- Dashboard ---
DASH_USER=admin
DASH_PASSWORD=change-me-now
DASH_PORT=8080
TZ_NAME=America/Chicago
DB_PATH=data/trades.db
